# Copy to .env and change the values:   cp .env.example .env   (PowerShell: Copy-Item .env.example .env)

# ---------- Application (docker-compose.yml) ----------
APP_PORT=3000
POSTGRES_PASSWORD=change_me_db_password
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
DOCKER_REGISTRY=murlee7
IMAGE_TAG=latest

# ---------- CI/CD toolchain (docker-compose.cicd.yml) ----------
# Jenkins web port on your laptop (change if 8080 is already used)
JENKINS_PORT=8090
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change_me_jenkins_password
GIT_REPO_URL=https://github.com/murlee7/secure-devsecops-pipeline.git
GIT_BRANCH=main

# Create in SonarQube: My Account -> Security -> Generate Token (type: Global Analysis)
SONAR_TOKEN=

# Docker Hub -> Account settings -> Personal access tokens (Read & Write)
DOCKERHUB_USER=murlee7
DOCKERHUB_TOKEN=

# Secrets Jenkins injects into the deployed app (Compose / Kubernetes)
APP_JWT_SECRET=change_me_to_another_long_random_string_32_chars
APP_DB_PASSWORD=change_me_db_password

# Optional — only for the aws-eks deploy target (IAM user with ECR + EKS access)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
